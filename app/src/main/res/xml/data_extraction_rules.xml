<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Cloud tokens stay on the device; a restored app signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sync_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sync_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
